{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // انزل فين؟: static route pages served from Cloudflare's edge, plus a small Worker for /api/*.
  "name": "anzelfein",
  "compatibility_date": "2026-09-27",
  // The only server code: /api/* (the corrections form). Everything else is served from assets.
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "anzelfein-feedback",
      "database_id": "c4325f08-1366-4196-9b51-ae5d3218beba",
      "migrations_dir": "migrations"
    }
  ],
  "routes": [
    { "pattern": "anzelfein.com", "custom_domain": true },
    { "pattern": "www.anzelfein.com", "custom_domain": true }
  ],
  // Production lives only on the custom domains; drafts get preview URLs on workers.dev.
  "workers_dev": false,
  "preview_urls": true
}
