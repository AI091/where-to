{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // انزل فين؟: static route pages served from Cloudflare's edge. Assets only, no Worker code.
  "name": "anzelfein",
  "compatibility_date": "2026-09-27",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "anzelfein.com", "custom_domain": true },
    { "pattern": "www.anzelfein.com", "custom_domain": true }
  ],
  // Production lives only on the custom domains; drafts get preview URLs on workers.dev.
  "workers_dev": false,
  "preview_urls": true
}
