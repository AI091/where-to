{
  "name": "site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "deploy": "astro build && wrangler deploy",
    "drafts": "DRAFTS=1 astro build && wrangler versions upload --assets ./dist-drafts --preview-alias drafts --message 'draft route pages'"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/aref-ruqaa": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "tailwindcss": "^4.3.3"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "wrangler": "^4.142.0"
  }
}
