---
/**
 * One page per trip, "ازاي تروح من X لـY", from src/data/routes.json
 * (made by scripts/generate-routes.ts).
 *
 * Design: the trip as a line coloured by vehicle (Option A), the route's name on a
 * painted sign like a microbus windscreen (Option B), and a small drawing of the
 * trip on top (Option C).
 */
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import RouteMap from '../components/RouteMap.astro';
import RouteSign from '../components/RouteSign.astro';
import WalkThere from '../components/WalkThere.astro';
import FeedbackForm from '../components/FeedbackForm.astro';
import data from '../data/routes.json';
import names from '../data/aliases.json';
import {
	type Page, viewSteps, rides, li, round5, mins, walkText, boardText, everyText, fareText,
	vehicleOf, vehicleColor, vehicleInk, vehicleShort,
} from '../lib/trip';

export function getStaticPaths() {
	return data.pages.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

const { page } = Astro.props as { page: Page };
const [best, ...others] = page.options;
const steps = viewSteps(page, best);
const firstBoard = steps.findIndex((s) => s.type === 'board');
const gray = '#9aa6ad';
const isBus = (v: string) => v === 'bus' || v === 'minibus';

const reverse = data.pages.find((p) => p.from.id === page.to.id && p.to.id === page.from.id);
const sameOrigin = data.pages.filter((p) => p.from.id === page.from.id && p.slug !== page.slug).slice(0, 5);

// Other names riders use for the two ends («المحطة» for محطة مصر), and notes on
// names people mix up (مطار النزهة is not Borg El Arab).
const aliases = names.aliases as Record<string, string[]>;
const notes = names.notes as Record<string, string>;
const ends = [page.from.ar, page.to.ar];
const otherNames = ends.filter((n) => aliases[n]).map((n) => `${n} = ${aliases[n].join(' / ')}`);
const endNotes = ends.map((n) => notes[n]).filter(Boolean);

// The official fare, when every ride's line is on the governorate's list.
const fare = rides(best).every((r) => r.fare !== null) ? rides(best).reduce((sum, r) => sum + r.fare!, 0) : null;
// Only the best option's rides show a fare.
const anyFare = rides(best).some((r) => r.fare !== null);

const title = `ازاي تروح من ${page.from.ar} ${li(page.to.ar)}؟`;
const firstRide = rides(best)[0];
const description =
	`من ${page.from.ar} ${li(page.to.ar)}: اركب ${vehicleShort(firstRide.vehicle)} «${firstRide.route}» من ${firstRide.from}. ` +
	`حوالي ${round5(best.minutes)} دقيقة${firstRide.everyMinutes ? `، و${everyText(firstRide.everyMinutes)}` : ''}.` +
	(otherNames.length ? ` (${otherNames.join('، ')})` : '');
const breadcrumbs = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'انزل فين؟', item: 'https://anzelfein.com/' },
		{ '@type': 'ListItem', position: 2, name: title, item: `https://anzelfein.com/${page.slug}/` },
	],
};
---

<Layout title={`${title} | انزل فين؟`} description={description} jsonLd={breadcrumbs}>
	<article class="pb-8">
		<RouteMap option={best} label={`خريطة المشوار من ${page.from.ar} ${li(page.to.ar)}`} />

		<h1 class="mt-6 text-3xl font-bold leading-snug text-sea-dark">{title}</h1>
		{otherNames.length > 0 && <p class="mt-2 text-sm text-muted">أسماء تانية: {otherNames.join('، ')}</p>}
		{endNotes.map((n) => <p class="mt-1 text-sm text-muted">{n}</p>)}

		<div class="mt-4 flex items-end gap-3">
			<p class="text-5xl font-bold leading-none">{round5(best.minutes)}</p>
			<p class="pb-1 text-muted">
				دقيقة تقريباً، {walkText(best.walkMeters)}{fare !== null && <>، والأجرة {fareText(fare)}</>}
			</p>
		</div>

		<ol class="mt-4 flex flex-wrap items-center gap-1.5" aria-label="ملخص المشوار">
			{
				best.steps.filter((s) => s.kind === 'ride' || s.meters >= 50).map((s, i) => (
					<>
						{i > 0 && <li aria-hidden="true" class="text-muted">‹</li>}
						{s.kind === 'walk' ? (
							<li class="inline-flex items-center gap-1 rounded-full bg-black/5 px-2 py-1 text-sm text-muted">
								<Icon name="walk" class="size-4" />
								{s.meters} م
							</li>
						) : (
							<li
								class="inline-flex items-center gap-1 rounded-full px-2.5 py-1 text-sm font-bold"
								style={`background:${vehicleColor[vehicleOf(s.vehicle)]}; color:${vehicleInk[vehicleOf(s.vehicle)]}`}
							>
								<Icon name={isBus(vehicleOf(s.vehicle)) ? 'bus' : 'microbus'} class="size-4" />
								{vehicleShort(s.vehicle)}
							</li>
						)}
					</>
				))
			}
		</ol>

		<ol class="mt-8">
			{
				steps.map((s, i) => {
					const line = !steps[i + 1] ? null : s.type === 'board' ? vehicleColor[s.vehicle] : gray;
					const color = s.type === 'board' || s.type === 'alight' ? vehicleColor[s.vehicle] : s.type === 'arrive' ? '#0b5e7a' : gray;
					const icon =
						s.type === 'walk' ? 'walk' : s.type === 'arrive' ? 'flag'
						: s.type === 'board' && s.ride.fromOnRoad ? 'hand' : isBus(s.vehicle) ? 'bus' : 'microbus';
					return (
						<li class="relative ps-14 pb-7">
							{line && (
								<span
									aria-hidden="true"
									class="absolute start-[21px] top-11 bottom-0 w-[6px] rounded-full"
									style={s.type === 'board'
										? `background:${line}`
										: `background: repeating-linear-gradient(to bottom, ${line} 0 6px, transparent 6px 12px)`}
								/>
							)}
							<span
								class="absolute start-0 top-0 grid size-12 place-items-center rounded-full border-[3px] bg-white"
								style={`border-color:${color}; color:${color}`}
							>
								<Icon name={icon} />
							</span>

							{s.type === 'walk' && (
								<p class="pt-3 text-muted">
									امشي {s.meters} متر (حوالي {mins(s.minutes)}) لحد <strong class="text-ink">{s.to}</strong>
								</p>
							)}
							{s.type === 'board' && (
								<div class="pt-1">
									<p class="text-lg font-bold">{boardText(s.ride)}</p>
									<RouteSign route={s.ride.route} vehicle={s.vehicle} />
									<p class="mt-2 text-sm leading-relaxed text-muted">
										{s.ride.vehicle}، اتجاه {s.ride.headsign}. {everyText(s.ride.everyMinutes)}
										{s.ride.fare !== null && <> الأجرة الرسمية {fareText(s.ride.fare)}.</>}
									</p>
									{i === firstBoard && <WalkThere geometry={s.ride.geometry} />}
								</div>
							)}
							{s.type === 'alight' && (
								<p class="pt-3 text-lg">
									انزل عند <strong>{s.ride.to}</strong>{' '}
									<span class="text-sm text-muted">(بعد حوالي {mins(round5(s.ride.minutes))})</span>
								</p>
							)}
							{s.type === 'arrive' && <p class="pt-3 text-lg font-bold text-sea-dark">وصلت {s.place}</p>}
						</li>
					);
				})
			}
		</ol>

		{
			others.length > 0 && (
				<section class="mt-2 border-t border-black/10 pt-6">
					<h2 class="text-xl font-bold text-sea-dark">لو عايز طريقة تانية</h2>
					<ul class="mt-3 space-y-3">
						{others.map((o) => (
							<li class="flex flex-wrap items-center gap-1.5">
								{rides(o).map((r, i) => (
									<>
										{i > 0 && <span class="text-muted">‹</span>}
										<span
											class="rounded-full px-2.5 py-1 text-sm font-bold"
											style={`background:${vehicleColor[vehicleOf(r.vehicle)]}; color:${vehicleInk[vehicleOf(r.vehicle)]}`}
										>
											{vehicleShort(r.vehicle)} «{r.route}»
										</span>
									</>
								))}
								<span class="text-sm text-muted">حوالي {round5(o.minutes)} دقيقة، {walkText(o.walkMeters)}</span>
							</li>
						))}
					</ul>
				</section>
			)
		}

		<p class="mt-8 text-sm leading-relaxed text-muted">
			الأوقات تقريبية. الخطوط ومواعيدها من مسح ميداني سنة 2022، ولو خط اتغير الصفحة دي ممكن تكون محتاجة تتحدث.
			{anyFare && ' الأجرة من تعريفة محافظة الإسكندرية الرسمية (مارس 2026).'}
		</p>

		<FeedbackForm page={`/${page.slug}/`} />

		{
			(reverse || sameOrigin.length > 0) && (
				<nav class="mt-8">
					<h2 class="text-lg font-bold text-sea-dark">مشاوير قريبة</h2>
					<ul class="mt-2 space-y-1.5">
						{reverse && (
							<li>
								<a class="text-sea underline" href={`/${reverse.slug}/`}>من {reverse.from.ar} {li(reverse.to.ar)}</a>
							</li>
						)}
						{sameOrigin.map((p) => (
							<li>
								<a class="text-sea underline" href={`/${p.slug}/`}>من {p.from.ar} {li(p.to.ar)}</a>
							</li>
						))}
					</ul>
				</nav>
			)
		}
	</article>
</Layout>
