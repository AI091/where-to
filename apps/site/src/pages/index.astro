---
import Layout from '../layouts/Layout.astro';
import data from '../data/routes.json';
import { li } from '../lib/trip';
import FeedbackForm from '../components/FeedbackForm.astro';

// The trip pages, grouped by where you start; the busiest starting points first.
const byOrigin = new Map<string, typeof data.pages>();
for (const p of data.pages) byOrigin.set(p.from.ar, [...(byOrigin.get(p.from.ar) ?? []), p]);
const origins = [...byOrigin.entries()].sort((a, b) => b[1].length - a[1].length);

// Design options stay in draft builds only.
const drafts = process.env.DRAFTS === '1';

const points = [
	{
		title: 'خطوط حقيقية',
		body: 'مبنية على مسح ميداني لـ 104 خط مشروع وتمناية وأتوبيس في إسكندرية.',
	},
	{
		title: 'زي ما المشروع بيمشي فعلاً',
		body: 'بتشاور له من أي حتة على طريقه، مش من المحطات بس، إلا على الكباري والطرق السريعة.',
	},
	{
		title: 'بالعربي وعلى قد السؤال',
		body: 'تركب إيه، ومنين، وتنزل عند إيه. من غير لف ولا تفاصيل مالهاش لازمة.',
	},
];
---

<Layout
	title="انزل فين؟ | دليل مواصلات إسكندرية"
	description="تركب إيه وتنزل فين في إسكندرية: دليل خطوط المشروع (الميكروباص) والتمناية والأتوبيس، مبني على مسح ميداني لـ 104 خط."
>
	<section class="py-12 sm:py-16">
		<h1 class="text-4xl font-bold leading-tight text-sea-dark sm:text-5xl">تركب إيه، وتنزل فين؟</h1>
		<p class="mt-5 max-w-xl text-lg leading-relaxed text-muted">
			دليل مواصلات إسكندرية. اختار مشوارك وهتعرف تركب مشروع ولا أتوبيس، تقف فين، وتنزل عند إيه بالظبط.
		</p>

		<svg aria-hidden="true" viewBox="0 0 640 120" class="mt-10 w-full">
			<path d="M8 90 C 120 90, 150 30, 260 30 S 420 95, 520 70 S 610 40, 632 40" fill="none" stroke="#0b5e7a" stroke-width="6" stroke-linecap="round" />
			<g fill="#f7f1e6" stroke="#0b5e7a" stroke-width="4">
				<circle cx="8" cy="90" r="8" />
				<circle cx="632" cy="40" r="8" />
			</g>
			<g transform="translate(372 58)">
				<path fill="#f29a2e" d="M0-38a15 15 0 0 0-15 15c0 11 15 27 15 27s15-16 15-27a15 15 0 0 0-15-15Z" />
				<circle cy="-23" r="5.5" fill="#fff" />
			</g>
		</svg>
	</section>

	<section class="grid gap-4 pb-12 sm:grid-cols-3">
		{
			points.map((p) => (
				<div class="rounded-2xl bg-white/70 p-5 shadow-sm ring-1 ring-black/5">
					<h2 class="text-lg font-bold text-sea-dark">{p.title}</h2>
					<p class="mt-2 leading-relaxed text-muted">{p.body}</p>
				</div>
			))
		}
	</section>

	<section class="pb-12" aria-labelledby="trips">
		<h2 id="trips" class="text-2xl font-bold text-sea-dark">مشاوير</h2>
		<div class="mt-4 space-y-6">
			{
				origins.map(([origin, pages]) => (
					<div>
						<h3 class="font-bold">من {origin}</h3>
						<ul class="mt-2 flex flex-wrap gap-2">
							{pages.map((p) => (
								<li>
									<a
										class="inline-block rounded-full bg-white px-3 py-1.5 text-sea-dark ring-1 ring-sea/20 hover:ring-sea focus-visible:outline-2 focus-visible:outline-sea"
										href={`/${p.slug}/`}
									>
										{li(p.to.ar)}
									</a>
								</li>
							))}
						</ul>
					</div>
				))
			}
		</div>
	</section>

	<div class="pb-12"><FeedbackForm page="/" variant="home" /></div>

	{
		drafts && (
			<section class="pb-12">
				<h2 class="text-xl font-bold text-sea-dark">خيارات التصميم (مسودة)</h2>
				<ul class="mt-3 space-y-2">
					{[
						['a', 'الخط'],
						['b', 'لافتة المشروع'],
						['c', 'الخريطة'],
					].map(([k, name]) => (
						<li>
							<a class="text-sea underline" href={`/options/${k}/el-sa-ah-to-train-station/`}>{name}</a>
						</li>
					))}
				</ul>
			</section>
		)
	}
</Layout>
