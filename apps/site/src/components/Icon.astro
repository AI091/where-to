---
/**
 * Outline icons, 24×24, drawn with the current text colour.
 * walk, hand, bus, flag, pin and clock paths are from Tabler Icons (MIT, tabler.io/icons);
 * the microbus is drawn to match. Vehicles are mirrored so they face the reading direction (RTL).
 */
interface Props {
	name: 'walk' | 'hand' | 'microbus' | 'bus' | 'flag' | 'pin' | 'clock';
	class?: string;
}
const { name, class: className = 'size-6' } = Astro.props;
const faces = name === 'microbus' || name === 'bus';
---

<svg
	aria-hidden="true"
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="2"
	stroke-linecap="round"
	stroke-linejoin="round"
	class={className}
	style={faces ? 'transform: scaleX(-1)' : undefined}
>
	{
		name === 'walk' && (
			<>
				<path d="M12 4a1 1 0 1 0 2 0a1 1 0 1 0 -2 0" />
				<path d="M7 21l3 -4" />
				<path d="M16 21l-2 -4l-3 -3l1 -6" />
				<path d="M6 12l2 -3l4 -1l3 3l3 1" />
			</>
		)
	}
	{
		name === 'hand' && (
			<>
				<path d="M8 13v-7.5a1.5 1.5 0 0 1 3 0v6.5" />
				<path d="M11 5.5v-2a1.5 1.5 0 1 1 3 0v8.5" />
				<path d="M14 5.5a1.5 1.5 0 0 1 3 0v6.5" />
				<path d="M17 7.5a1.5 1.5 0 0 1 3 0v8.5a6 6 0 0 1 -6 6h-2h.208a6 6 0 0 1 -5.012 -2.7l-.196 -.3c-.312 -.479 -1.407 -2.388 -3.286 -5.728a1.5 1.5 0 0 1 .536 -2.022a1.867 1.867 0 0 1 2.28 .28l1.47 1.47" />
			</>
		)
	}
	{
		name === 'microbus' && (
			<>
				<path d="M3 16v-9a1 1 0 0 1 1 -1h11l5 5v5h-1.5" />
				<path d="M9.5 16h5" />
				<path d="M3 11h17" />
				<path d="M8 6v5" />
				<path d="M12.5 6v5" />
				<circle cx="7" cy="16.5" r="1.8" />
				<circle cx="17" cy="16.5" r="1.8" />
			</>
		)
	}
	{
		name === 'bus' && (
			<>
				<path d="M4 17a2 2 0 1 0 4 0a2 2 0 1 0 -4 0" />
				<path d="M16 17a2 2 0 1 0 4 0a2 2 0 1 0 -4 0" />
				<path d="M4 17h-2v-11a1 1 0 0 1 1 -1h14a5 7 0 0 1 5 7v5h-2m-4 0h-8" />
				<path d="M16 5l1.5 7l4.5 0" />
				<path d="M2 10l15 0" />
				<path d="M7 5l0 5" />
				<path d="M12 5l0 5" />
			</>
		)
	}
	{
		name === 'flag' && (
			<>
				<path d="M5 5a5 5 0 0 1 7 0a5 5 0 0 0 7 0v9a5 5 0 0 1 -7 0a5 5 0 0 0 -7 0v-9z" />
				<path d="M5 21v-7" />
			</>
		)
	}
	{
		name === 'pin' && (
			<>
				<path d="M9 11a3 3 0 1 0 6 0a3 3 0 0 0 -6 0" />
				<path d="M17.657 16.657l-4.243 4.243a2 2 0 0 1 -2.827 0l-4.244 -4.243a8 8 0 1 1 11.314 0z" />
			</>
		)
	}
	{
		name === 'clock' && (
			<>
				<path d="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0" />
				<path d="M12 7v5l3 3" />
			</>
		)
	}
</svg>
